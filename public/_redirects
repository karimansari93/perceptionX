# Hashed build assets are content-addressed. A request for one that doesn't
# exist means the client is running a stale index.html from a previous deploy.
# Return a real 404 instead of letting it fall through to the SPA rewrite below
# (which would serve index.html with a JS/CSS MIME type and break module
# loading). The app's lazyWithRetry detects the failed import and hard-reloads
# to pick up the fresh manifest.
/assets/*  /assets/:splat  404

# Onboarding invites get onboarding.html — same app bundle, but with
# project-setup meta tags so link previews don't show the sign-in copy even
# when the crawler never executes JS. Generated at build time in vite.config.ts.
/onboarding/*  /onboarding.html  200

# Activate links get activate.html for the same reason — the static floor under
# netlify/edge-functions/activate-meta.ts, which personalizes it per token.
/activate/*  /activate.html  200

# The per-token share card is drawn by netlify/edge-functions/activate-og.ts,
# which never calls next(); this rule only matters if edge functions aren't
# running at all, and exists so that case degrades to the baked card instead of
# serving index.html under an image/* expectation and unfurling as a blank box.
/activate-og/*  /logos/activate-og.png  200

# MCP server (Streamable HTTP + OAuth 2.1) — proxied to the mcp-server edge
# function so clients get a stable, root-domain URL (https://app.perceptionx.ai/mcp)
# and the OAuth discovery documents can live at the domain root, where
# RFC 8414/9728 clients look for them. 200 = reverse proxy, not a redirect:
# POST bodies and Authorization headers pass through.
/.well-known/oauth-authorization-server        https://ofyjvfmcgtntwamkubui.supabase.co/functions/v1/mcp-server/.well-known/oauth-authorization-server  200
/.well-known/oauth-authorization-server/*      https://ofyjvfmcgtntwamkubui.supabase.co/functions/v1/mcp-server/.well-known/oauth-authorization-server  200
/.well-known/oauth-protected-resource          https://ofyjvfmcgtntwamkubui.supabase.co/functions/v1/mcp-server/.well-known/oauth-protected-resource   200
/.well-known/oauth-protected-resource/*        https://ofyjvfmcgtntwamkubui.supabase.co/functions/v1/mcp-server/.well-known/oauth-protected-resource   200
/mcp     https://ofyjvfmcgtntwamkubui.supabase.co/functions/v1/mcp-server         200!
/mcp/*   https://ofyjvfmcgtntwamkubui.supabase.co/functions/v1/mcp-server/:splat  200!

# SPA fallback for client-side routes.
/*    /index.html   200
